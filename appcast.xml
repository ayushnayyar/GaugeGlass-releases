<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Sparkle appcast feed for GaugeGlass.

  The app reads this feed from its SUFeedURL:
    https://mangostruck.com/gaugeglass/appcast.xml
  This file is the canonical committed copy and a fallback; it is NOT the URL the app polls.

  The <item>s are GENERATED by `generate_appcast` (scripts/release.sh in the private source
  repo) on each release — do not hand-edit them. Enclosure URLs point at this repository's
  Releases, so the update download is served from GitHub.

  This scaffold carries no items: a valid "no updates available" feed, so the URL resolves
  before the first GaugeGlass release populates it. The previous contents advertised AI Limits
  2.5.0 with an enclosure under the old repository name — a URL that 404s, for a product that
  no longer exists under that name and never shipped to a customer.
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
    <channel>
        <title>GaugeGlass</title>
        <link>https://mangostruck.com/gaugeglass/appcast.xml</link>
        <description>Updates for GaugeGlass</description>
        <language>en</language>
    </channel>
</rss>
